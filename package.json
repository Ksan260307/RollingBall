{
  "name": "rolling-ball",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Downhill ball-rolling time attack game (Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "courses": "vite --open /tools/course-editor/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build:desktop && electron desktop/main.cjs",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && electron-builder",
    "build:desktop": "tsc --noEmit && vite build --base=./"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "main": "desktop/main.cjs",
  "productName": "Rolling Ball Time Attack",
  "build": {
    "appId": "com.example.rollingball",
    "productName": "RollingBallTimeAttack",
    "directories": {
      "output": "desktop-build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "${productName}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "extraResources": [
      {
        "from": "desktop/steam_appid.txt",
        "to": "../steam_appid.txt"
      }
    ]
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  }
}
